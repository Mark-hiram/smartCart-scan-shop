# ADMIN_SETUP_KEY: Required in production (minimum 24 characters) to initialize the single system admin at /admin/login.
ADMIN_SETUP_KEY=

# ADMIN_EMAIL / ADMIN_PASSWORD: Optional env vars to auto-initialize the single system admin account on startup (min 8-char password).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# DEMO_MODE: Keep set to "false" (all demo data has been removed; production refuses to start if "true").
DEMO_MODE=false

# DB_PATH: File system path for persistent JSON database storage (e.g. /var/data/smartcart_db.json on Render).
DB_PATH=./data/smartcart_db.json

# TRUST_PROXY: Set to "true" behind a reverse proxy (Render, Cloud Run, Nginx) so per-IP rate limiting uses X-Forwarded-For.
TRUST_PROXY=true

# SESSION_HOURS: Sliding session inactivity lifetime in hours for shoppers, staff, and owners (admin is fixed at 2 hours).
SESSION_HOURS=12

# PORT: HTTP port bound by the server on 0.0.0.0 (default: 3000; Render provides PORT automatically).
PORT=3000

# NODE_ENV: Runtime mode ("development" or "production").
NODE_ENV=production

# GEMINI_API_KEY: Optional server-side API key for Smart Cart AI chat and Google Maps Grounding.
GEMINI_API_KEY=

# AI_DAILY_CAP / AI_USER_HOURLY_CAP / AI_USER_DAILY_CAP: Server-side AI quota guards (defaults: 500/day global, 20/hr user, 50/day user).
AI_DAILY_CAP=500
AI_USER_HOURLY_CAP=20
AI_USER_DAILY_CAP=50

# Transactional Email Delivery (Resend HTTP API — server-side only, never use VITE_ prefix)
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_DAILY_CAP=200

# APP_URL: Optional public URL where this application is hosted (used in admin reset & portal links).
APP_URL=

# Optional Copyright & Legal Display Overrides & Support Contact
VITE_COPYRIGHT_OWNER=
VITE_CONTACT_EMAIL=
VITE_SUPPORT_PHONE=
