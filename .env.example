# GEMINI_API_KEY: Required on the server for Gemini AI chat and Google Maps Grounding.
# Never expose this key to client/browser code.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this application is hosted.
APP_URL="MY_APP_URL"

# ADMIN_SETUP_KEY: Required secret key to initialize the single system administrator account at /admin/login.
# In production (NODE_ENV=production), admin setup is refused if this variable is not set.
ADMIN_SETUP_KEY="CHANGE_ME_STRONG_ADMIN_SETUP_SECRET"

# DEMO_MODE: Controls whether demo passwords, demo seed accounts, and demo reset codes are active.
# Must be "false" in production.
DEMO_MODE="false"

# DB_PATH: File system path for persistent JSON database storage (use a mounted persistent volume in production).
DB_PATH="./smartcart_db.json"

# PORT: HTTP port for the Express + Vite server (default: 3000).
PORT="3000"

# TRUST_PROXY: Set to "true" when running behind a reverse proxy (e.g. Cloud Run, Render, Nginx)
# so per-IP rate limiting reads X-Forwarded-For accurately.
TRUST_PROXY="false"

# SESSION_HOURS: Session inactivity lifetime in hours for non-admin users (default: 12; admin is fixed at 2 hours).
SESSION_HOURS="12"
